# SNAKEMAKE FILE FOR METAGENOMIC PIPELINE
# Last Updated: 2026-07-28
# Author: Matias Becker Burgos (Matias.BeckerBurgos@unil.ch)

##################################################
# DESCRIPTION
##################################################
# Main Pipeline file to Launch the Metagenomic pipeline
# Steps included:
# 01: Concatenation and preprocessing (always runs unless QC: false)
# 01b: Clean data check (runs if QC: false)
# 02: Metagenome Assembly
# 02b: (Optional) Taxonomic Profiling
# 03: Binning (MetaBAT2 + MaxBin2 + SemiBin2 -> DASTool -> CheckM2) (if True run 03b)
# 03b: Alternative Binning with MetaBAT2 standalone
# 04: MAG Reporting & Annotation
# 05: Final MultiQC Report

##################################################
# CONFIGURATION
##################################################
configfile: "../config/config.yaml"

##################################################
# SET UP VARIABLES
##################################################

import os
import sys

DATA_DIR    = config["input_dir"]
SCRATCH_DIR = config["scratch_dir"]
OUTPUT_DIR  = config["working_dir"]
LOG_DIR     = config["log_dir"]
BENCH_DIR   = config["benchmark_dir"]

## Cleaned-reads directory — produced by host_filtering when QC runs; otherwise
## assumed to already exist in DATA_DIR (pre-cleaned input).
CLEAN_DATA_DIR = (
    f"{OUTPUT_DIR}/00_Data/02_Clean_Data"
    if config["steps"].get("QC", True)
    else DATA_DIR
)

## High-quality bins directory — produced by whichever binning branch ran
## (03b standalone MetaBAT2, or 03 MetaBAT2+MaxBin2+SemiBin2 -> DAS_Tool).
## Downstream rules (module 04) read from this, never a hardcoded literal,
## so they're agnostic to which branch produced it.
HIGHQC_BINS_DIR = (
    f"{OUTPUT_DIR}/02_Results/03_Binning/HighQC_Bins_MetaBAT2/"
    if config["steps"].get("alternative_binning", True)
    else f"{OUTPUT_DIR}/02_Results/03_Binning/HighQC_Bins/"
)

include: "rules/00_common.smk"

SAMPLES = detect_samples(DATA_DIR)
logger.info(f"Detected {len(SAMPLES)} samples: {', '.join(SAMPLES)}")

BLANKS  = get_excluded_samples(SAMPLES)
CONTIGS = [s for s in SAMPLES if s not in BLANKS]
if BLANKS:
    logger.info(
    f"Excluded samples (blanks/controls, {len(BLANKS)}): "
    f"{', '.join(str(x) for x in BLANKS if x is not None)}"
)
logger.info(
    f"Samples proceeding to binning ({len(CONTIGS)}): "
    f"{', '.join(str(x) for x in CONTIGS if x is not None)}"
)

##################################################
# STARTUP VALIDATION
##################################################

onstart:
    errors = []

    for key in ("input_dir", "working_dir", "scratch_dir"):
        if not os.path.isdir(config[key]):
            errors.append(f"[config] '{key}' not found: {config[key]}")

    # Database paths — only check when the step that uses them is enabled
    if config["steps"].get("QC", True) or config["steps"].get("taxonomic_profiling"):
        db_dir = config.get("kraken2_db", {}).get("DB_dir", "")
        if db_dir and not os.path.isdir(db_dir):
            errors.append(f"[config] kraken2_db.DB_dir not found: {db_dir}")

    if config["steps"].get("MAGs_Reporting_step"):
        gtdb_db = config.get("GTDB_Tk", {}).get("db", "")
        if gtdb_db and not os.path.isdir(gtdb_db):
            errors.append(f"[config] GTDB_Tk.db not found: {gtdb_db}")

    if not SAMPLES:
        errors.append(f"[samples] No samples detected in input_dir: {config['input_dir']}")

    if config["steps"].get("QC", True):
        concat = config["steps"].get("concatenate_lanes", True)
        mode = "multi-lane (cat)" if concat else "pre-concatenated (symlink)"
        logger.info(f"Lane handling: {mode}")
    else:
        # QC disabled — cleaned reads must already exist in DATA_DIR
        missing = [
            s for s in SAMPLES
            if not os.path.isfile(f"{CLEAN_DATA_DIR}/{s}_R1_cleaned.fastq.gz")
        ]
        if missing:
            errors.append(
                f"[steps] QC is disabled but cleaned reads not found in "
                f"input_dir ({CLEAN_DATA_DIR}). "
                f"Missing R1 for: {', '.join(missing[:5])}"
                + (" ..." if len(missing) > 5 else "")
                + ". Expected pattern: {sample}_R1_cleaned.fastq.gz"
            )

    if BLANKS:
        logger.info(f"Blank/excluded samples ({len(BLANKS)}): {', '.join(BLANKS)}")
        logger.info(f"Samples proceeding to binning: {len(CONTIGS)}")

    if errors:
        sys.exit("Pipeline startup failed:\n" + "\n".join(f"  {e}" for e in errors))

##################################################
# RULE ALL — dynamic based on enabled steps
##################################################

# Reference outputs (uncomment and add to get_final_outputs() to target a specific stage):
#   QC After:         f"{OUTPUT_DIR}/02_Results/01_QC_Preprocessing/QC_After"
#   Kraken2 combined: f"{OUTPUT_DIR}/02_Results/01_QC_Preprocessing/Kraken2/Combined_kraken2_report.tsv"
#   Assembly multiqc: f"{OUTPUT_DIR}/02_Results/02_Assembly/Metaquast_QC/multiqc_report.html"
#   MAG info:         f"{OUTPUT_DIR}/02_Results/04_MAGs_Reporting_Annotating/MAG_Representative_info_parsed.tsv"
#   iTOL tree:        f"{OUTPUT_DIR}/02_Results/04_MAGs_Reporting_Annotating/iTOL_visualisation/gtdbtk.bac120.iTOL.MAGs.tree"
#   Final report:    f"{OUTPUT_DIR}/02_Results/MultiQC_FinalReport/multiqc_report.html"

def get_final_outputs():
    outputs = []

    # Tool-versions report — unconditional, independent of final_report, same
    # reproducibility value whether or not the full aggregate report is built.
    outputs.append(f"{OUTPUT_DIR}/02_Results/tool_versions.tsv")

    # QC always produces cleaned reads; use the After QC report as the anchor
    if config["steps"].get("QC", True):
        outputs.append(f"{OUTPUT_DIR}/02_Results/01_QC_Preprocessing/QC_After")
    elif config["steps"].get("check_clean_data", True):
        outputs.append(f"{OUTPUT_DIR}/02_Results/01_QC_Preprocessing/QC_Check")

    if config["steps"].get("taxonomic_profiling"):
        outputs.append(
            f"{OUTPUT_DIR}/02_Results/01_QC_Preprocessing/Kraken2/Combined_kraken2_report.tsv"
        )

    if config["steps"].get("MAGs_Reporting_step"):
        outputs.append(
            f"{OUTPUT_DIR}/02_Results/04_MAGs_Reporting_Annotating/MAG_Representative_info_parsed.tsv"
        )

        # iTOL tree (gtdbtk infer + decorate: one tree over all HQ MAGs, GTDB_Tk resources),
        # plus the per-MAG annotation strips, which need sample metadata to label hosts
        if config["steps"].get("iTOL_visualisation", True):
            outputs.append(
                f"{OUTPUT_DIR}/02_Results/04_MAGs_Reporting_Annotating/iTOL_visualisation/gtdbtk.bac120.iTOL.MAGs.tree"
            )
            if config.get("DATA_VARIABLES", {}).get("metadata_path"):
                outputs.append(
                    f"{OUTPUT_DIR}/02_Results/04_MAGs_Reporting_Annotating/iTOL_visualisation/Annotation_files"
                )

    if config["steps"].get("final_report"):
        outputs.append(
            f"{OUTPUT_DIR}/02_Results/MultiQC_FinalReport/multiqc_report.html"
        )

    return outputs


rule all:
    input:
        get_final_outputs()


##################################################
# TOOL VERSIONS — cross-cutting, lives here rather than in any single
# conditionally-included stage file, since it must exist regardless of which
# steps are enabled (every "version probe" rule below is defined in whichever
# stage file already uses that tool's conda env; this just aggregates them).
##################################################

def _get_tool_version_inputs():
    files = [
        f"{OUTPUT_DIR}/01_Analysis/ToolVersions/qc_env_versions.tsv",
        f"{OUTPUT_DIR}/01_Analysis/ToolVersions/assembly_versions.tsv",
        f"{OUTPUT_DIR}/01_Analysis/ToolVersions/fairy_versions.tsv",
        f"{OUTPUT_DIR}/01_Analysis/ToolVersions/binning_versions.tsv",
    ]
    if config["steps"].get("QC", True):
        files += [
            f"{OUTPUT_DIR}/01_Analysis/ToolVersions/trimmomatic_versions.tsv",
            f"{OUTPUT_DIR}/01_Analysis/ToolVersions/bowtie2_versions.tsv",
        ]
    if config["steps"].get("QC", True) or config["steps"].get("taxonomic_profiling"):
        files.append(f"{OUTPUT_DIR}/01_Analysis/ToolVersions/kraken2_versions.tsv")
    if not config["steps"].get("alternative_binning", True):
        files.append(f"{OUTPUT_DIR}/01_Analysis/ToolVersions/semibin2_versions.tsv")
    if config["steps"].get("MAGs_Reporting_step"):
        files.append(f"{OUTPUT_DIR}/01_Analysis/ToolVersions/reporting_versions.tsv")
    return files


rule aggregate_tool_versions:
    input:
        _get_tool_version_inputs()
    output:
        f"{OUTPUT_DIR}/02_Results/tool_versions.tsv"
    localrule: True
    shell:
        """
        (printf "tool\\tversion\\n"; cat {input}) > {output}
        """


##################################################
# LIFECYCLE HANDLERS
##################################################

onsuccess:
    logger.info("Pipeline completed successfully.")
    # Only run standalone when final_report is disabled — that rule already runs it
    if not config["steps"].get("final_report"):
        shell(
            f"python {{workflow.basedir}}/scripts/aggregate_benchmarks.py "
            f"--bench-dir {BENCH_DIR} "
            f"--output {OUTPUT_DIR}/02_Results/benchmark_summary.tsv"
        )
        logger.info(f"Benchmark summary written to {OUTPUT_DIR}/02_Results/benchmark_summary.tsv")

onerror:
    logger.error(
        f"Pipeline failed. Check logs in: {LOG_DIR}\n"
        f"Resume with: snakemake --rerun-incomplete --profile slurm --use-conda"
    )

##################################################
# RULES
##################################################
if config["steps"].get("QC", True):
    include: "rules/01_quality_control_preprocessing.smk"
else:
    include: "rules/01b_clean_data_check.smk"

include: "rules/02_assembly.smk"

if config["steps"].get("taxonomic_profiling"):
    include: "rules/02b_Taxonomic_Profiling.smk"

if config["steps"].get("alternative_binning", True):
    include: "rules/03b_Binning_MetaBAT2.smk"
else:
    include: "rules/03_binning.smk"

if config["steps"].get("MAGs_Reporting_step"):
    include: "rules/04_MAGs_Reporting_Annotating.smk"

if config["steps"].get("final_report"):
    include: "rules/05_final_report.smk"

##################################################
# END OF SNAKEMAKE FILE
